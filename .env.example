# Canonical site URL. Used for metadata, canonical tags, sitemap and robots.
#
# This MUST match the host the site is actually served on, exactly — including
# www or its absence, and with no trailing slash. If it does not match, the
# sitemap will list URLs on a host that only redirects, and Google Search
# Console will refuse them ("couldn't fetch" / URLs outside property scope).
#
# The production host redirects the bare domain to www, so www is canonical.
NEXT_PUBLIC_SITE_URL=https://www.tikobanezimbabwe.org

# Where contact form submissions are forwarded (email service, CRM or automation
# webhook). Receives JSON: { form: "contact", name, email, phone, reason, message, receivedAt }
CONTACT_WEBHOOK_URL=

# Optional separate endpoint for newsletter signups. Falls back to
# CONTACT_WEBHOOK_URL. Receives JSON: { form: "newsletter", email, receivedAt }
NEWSLETTER_WEBHOOK_URL=

# Checkout URL for the payment provider Tikobane uses. The donate form appends
# ?amount=&frequency=&designation= and redirects the donor there.
# Prefer a provider that supports local Zimbabwean payment methods.
DONATION_CHECKOUT_URL=

# SMTP overrides for appsettings.json. Keep the password in .env.local or host secrets.
SMTP_REF_LINK=https://tikobanezimbabwe.org/
SMTP_HOST=smtp.itanywhere.africa
SMTP_USERNAME=noreply@shearwatervf.com
SMTP_PASSWORD=
SMTP_FROM="Tikobane Zimbabwe <noreply@shearwatervf.com>"
SMTP_ADMIN_EMAIL=info@tikobanezimbabwe.org
SMTP_PORT=587
# Port 587 requires STARTTLS; false means no implicit TLS.
SMTP_SECURE=false
